{
  "name": "fulcrum-gateway",
  "private": true,
  "type": "module",
  "description": "Fulcrum gateway: a Cloudflare Worker that fronts each product's backend (PostgREST + GoTrue + Storage protocol) so the target behind it can change without publishing an app.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "tsc --noEmit && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:contract": "vitest run test/contract",
    "dev": "wrangler dev --env entrelares-dev"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260907.1",
    "@types/node": "^26.4.1",
    "prettier": "^3.9.6",
    "smol-toml": "^1.8.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0",
    "wrangler": "^4.129.0",
    "yaml": "^2.9.0"
  }
}
