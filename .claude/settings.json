{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cd:*)",
      "Bash(bash tool/setup_env.sh)",
      "Bash(git status:*)", "Bash(git log:*)", "Bash(git diff:*)", "Bash(git show:*)",
      "Bash(git branch:*)", "Bash(git ls-files:*)", "Bash(git cherry:*)", "Bash(git fetch:*)",
      "Bash(git pull:*)", "Bash(git checkout:*)", "Bash(git switch:*)", "Bash(git add:*)",
      "Bash(git commit:*)", "Bash(git push:*)",
      "Bash(npm ci:*)", "Bash(npm install:*)", "Bash(npm run:*)", "Bash(npm test:*)",
      "Bash(npx vitest:*)", "Bash(npx tsc:*)", "Bash(npx prettier:*)",
      "Bash(npx wrangler dev:*)", "Bash(npx wrangler types:*)",
      "Bash(node:*)"
    ],
    "deny": [
      "Bash(npx wrangler deploy:*)",
      "Bash(npx wrangler secret:*)",
      "Bash(wrangler deploy:*)",
      "Bash(wrangler secret:*)"
    ]
  }
}
